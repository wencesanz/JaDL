{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/studio/kindly-made",
      "destination": "/studio/never-thought-studio",
      "permanent": true
    },
    {
      "source": "/studio/hugo-and-marie",
      "destination": "/studio/studio-and-marie",
      "permanent": true
    },
    {
      "source": "/studio/studio-thomas",
      "destination": "/studio/guest-studio",
      "permanent": true
    },
    {
      "source": "/studio/perron-roettinger",
      "destination": "/studio/perron",
      "permanent": true
    },
    {
      "source": "/studio/ortnerschinko",
      "destination": "/studio/ortner-etc",
      "permanent": true
    },
    {
      "source": "/studio/maud",
      "destination": "/city/melbourne",
      "permanent": true
    },
    {
      "source": "/studio/nslt",
      "destination": "/studio/bureau-nicolas-leuliet",
      "permanent": true
    },
    {
      "source": "/studio/jam3",
      "destination": "/city/toronto",
      "permanent": true
    },
    {
      "source": "/studio/a-line-studio",
      "destination": "/city/san-francisco",
      "permanent": true
    },
    {
      "source": "/studio/address-arts",
      "destination": "/country/usa",
      "permanent": true
    },
    {
      "source": "/studio/bou",
      "destination": "/city/helsinki",
      "permanent": true
    },
    {
      "source": "/studio/pop-and-pac",
      "destination": "/studio/poc-and-pac",
      "permanent": true
    },
    {
      "source": "/studio/studio-dp",
      "destination": "/studio/studio-daniel-peter",
      "permanent": true
    },
    {
      "source": "/studio/the-phoney-club",
      "destination": "/studio/phoney",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(disciplines|countries|cities|regions|studios|geography|categories|about|submit|list)",
      "destination": "/index"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
