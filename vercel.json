{
  "cleanUrls": true,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/studio/(.*)", "dest": "/index.html" },
    { "src": "/discipline/(.*)", "dest": "/index.html" },
    { "src": "/country/(.*)", "dest": "/index.html" },
    { "src": "/city/(.*)", "dest": "/index.html" },
    { "src": "/(disciplines|countries|cities|studios|geography|categories|about|submit)", "dest": "/index.html" },
    {
      "src": "/sw.js",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate", "Service-Worker-Allowed": "/" },
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.json",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "dest": "/manifest.json"
    },
    {
      "src": "/dist/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "dest": "/dist/$1"
    },
    {
      "src": "/icons/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "dest": "/icons/$1"
    },
    {
      "src": "/feed.xml",
      "headers": { "Content-Type": "application/rss+xml; charset=utf-8", "Cache-Control": "public, max-age=0, must-revalidate" },
      "dest": "/feed.xml"
    },
    {
      "src": "/sitemap.xml",
      "headers": { "Content-Type": "application/xml; charset=utf-8" },
      "dest": "/sitemap.xml"
    },
    {
      "src": "/styles.css",
      "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" },
      "dest": "/styles.css"
    }
  ]
}
